rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      
      // Permitir escritura si está autenticado o si es una subida de perfil (siempre que sea desarrollo)
      allow write: if request.auth != null || true; 
    }
  }
}
